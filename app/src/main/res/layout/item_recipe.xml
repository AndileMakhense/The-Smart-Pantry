<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp" android:background="@drawable/card_background"
    android:orientation="vertical">
    <TextView android:id="@+id/textRecipeName" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/green_900"
        android:textSize="19sp" android:textStyle="bold" />
    <TextView android:id="@+id/textRecipeSummary" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="5dp"
        android:textColor="@color/gray_600" android:textSize="14sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="end" android:layout_marginTop="8dp" android:text="View recipe >"
        android:textColor="@color/green_700" android:textStyle="bold" />
</LinearLayout>
