<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/green_900"
    android:padding="6dp">
    <Button android:id="@+id/navPantry" android:layout_width="0dp" android:layout_height="48dp"
        android:layout_weight="1" android:text="Pantry" android:textAllCaps="false" />
    <Button android:id="@+id/navRecipes" android:layout_width="0dp" android:layout_height="48dp"
        android:layout_weight="1" android:text="Recipes" android:textAllCaps="false" />
    <Button android:id="@+id/navSettings" android:layout_width="0dp" android:layout_height="48dp"
        android:layout_weight="1" android:text="Settings" android:textAllCaps="false" />
</LinearLayout>
