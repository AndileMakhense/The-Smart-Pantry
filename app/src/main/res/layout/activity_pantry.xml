<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/cream">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/green_700" android:padding="20dp" android:text="My Pantry"
        android:textColor="@color/white" android:textSize="26sp" android:textStyle="bold" />
    <TextView android:id="@+id/textPantrySummary" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="14dp"
        android:textColor="@color/gray_600" android:textSize="14sp" />
    <TextView android:id="@+id/textEmptyPantry" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:gravity="center"
        android:padding="32dp" android:text="Your pantry is empty. Add an ingredient to begin."
        android:textColor="@color/gray_600" android:textSize="17sp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerPantry"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:padding="12dp" />
    <Button android:id="@+id/buttonAddIngredient" style="@style/PrimaryButton"
        android:layout_marginLeft="16dp" android:layout_marginRight="16dp" android:layout_marginBottom="12dp"
        android:text="Add ingredient" />
    <include layout="@layout/view_navigation" />
</LinearLayout>
