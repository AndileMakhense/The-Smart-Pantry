<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/cream">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/green_700" android:padding="20dp" android:text="Suggested Recipes"
        android:textColor="@color/white" android:textSize="26sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="16dp" android:text="Only recipes for which every ingredient and required quantity is available are shown."
        android:textColor="@color/gray_600" />
    <TextView android:id="@+id/textNoMatches" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:gravity="center"
        android:padding="32dp" android:text="No recipes match your pantry yet. Add more ingredients or increase quantities."
        android:textColor="@color/gray_600" android:textSize="17sp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerRecipes"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:padding="12dp" />
    <include layout="@layout/view_navigation" />
</LinearLayout>
