<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SmartPantry" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/green_700</item>
        <item name="colorPrimaryDark">@color/green_900</item>
        <item name="colorAccent">@color/green_700</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/green_900</item>
        <item name="android:windowBackground">@color/cream</item>
    </style>

    <style name="PrimaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">@color/green_700</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
